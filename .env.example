# Astrolabio — plantilla de configuración.
# Copiar a .env y rellenar. NUNCA poner valores reales en este archivo.
#
# Los valores presentes son marcadores de desarrollo: sirven para que un clon
# limpio levante con `docker compose up --build` sin pasos manuales (criterio
# A1). No son credenciales de nada real y deben cambiarse en cualquier
# despliegue que no sea el portátil de quien programa.

# --- base de datos ---
POSTGRES_USER=astrolabio
POSTGRES_PASSWORD=astrolabio-dev
POSTGRES_DB=astrolabio
DATABASE_URL=postgresql+psycopg://astrolabio:astrolabio-dev@db:5432/astrolabio

# --- red interna ---
# Nombre y puerto del servicio de la API dentro de la red de compose. El proxy
# de `web` los recibe por entorno; no van escritos en ninguna config (A3).
API_HOST=api
API_PORT=8000
# Puerto por el que se publica la aplicación en el host. Es la única dirección
# que ve el navegador, incluida la del editor por Tailscale (ADR 0005).
WEB_PORT=8080

# --- api ---
# true solo cuando se sirva por HTTPS (variante C del ADR 0002)
COOKIE_SECURE=false

# --- siembra inicial (solo para el primer arranque) ---
# Marcadores de desarrollo, como los de Postgres. En cualquier despliegue real
# se cambian: son las credenciales con las que se entra a la aplicacion.
SEED_INVESTIGADOR_USER=johan
SEED_INVESTIGADOR_PASSWORD=investigador-dev
SEED_EDITOR_USER=dathzon
SEED_EDITOR_PASSWORD=editor-dev

